/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

/favicon.ico
  Cache-Control: public,max-age=31536000,immutable
  Content-Type: image/x-icon

/icons/*
  Cache-Control: public,max-age=31536000,immutable

/site.webmanifest
  Cache-Control: public,max-age=86400
  Content-Type: application/manifest+json
