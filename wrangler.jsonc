{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pgi-website-v2",
  "main": "worker.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    "crons": ["0 3 * * *"],
  },
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://paragoninvestments.org",
    "NEXT_PUBLIC_SITE_URL": "https://paragoninvestments.org",
    "NEXT_PUBLIC_PORTAL_URL": "https://portal.paragoninvestments.org",
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "pgi-website-v2",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "pgi-website-v2-cache",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler",
      },
      {
        "name": "NEXT_TAG_CACHE_DO_SHARDED",
        "class_name": "DOShardedTagCache",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1-cache",
      "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"],
    },
  ],
}
